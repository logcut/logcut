{
  // Solution-style: owns no files, only points the editor at the two real
  // projects. The src project excludes tests (they may use node globals), so
  // without this file the test files would belong to no project the language
  // server can find and the editor would fall back to an inferred one.
  "files": [],
  "references": [{ "path": "./tsconfig.src.json" }, { "path": "./tsconfig.test.json" }]
}
