{
  "name": "@logcut/core",
  "version": "0.1.0",
  "description": "Platform-neutral editing core for LogCut: transcript model, segmentation, and SRT serialization.",
  "keywords": [
    "video-editing",
    "transcript",
    "subtitles",
    "srt",
    "speech-to-text",
    "asr",
    "text-based-editing",
    "logcut"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Sigmify LLC",
    "url": "https://logcut.com"
  },
  "homepage": "https://logcut.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logcut/logcut.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/logcut/logcut/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --experimental-strip-types --test src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
