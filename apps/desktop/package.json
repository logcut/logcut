{
  "name": "logcut",
  "version": "0.1.2",
  "description": "LogCut desktop app — the open source AI video editor",
  "license": "Apache-2.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
