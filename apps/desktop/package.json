{
  "name": "logcut",
  "version": "0.1.3",
  "description": "LogCut desktop app — edit video by editing text",
  "license": "Apache-2.0",
  "author": {
    "name": "Sigmify LLC",
    "url": "https://logcut.com"
  },
  "homepage": "https://logcut.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logcut/logcut.git",
    "directory": "apps/desktop"
  },
  "bugs": {
    "url": "https://github.com/logcut/logcut/issues"
  },
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "package:mac": "electron-builder --mac --arm64 --publish always",
    "package:win": "electron-builder --win nsis --x64 --publish always",
    "package:linux": "electron-builder --linux AppImage --x64 --publish always",
    "package:win:zip": "electron-builder --win zip --x64 --publish never -c.directories.output=release-zip"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@logcut/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.25.0",
    "radix-ui": "^1.6.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "43.2.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.0"
  }
}
