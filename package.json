{
  "name": "logcut-workspace",
  "version": "0.0.0",
  "description": "Workspace root for LogCut — the open source AI video editor",
  "license": "Apache-2.0",
  "author": {
    "name": "Sigmify LLC",
    "url": "https://logcut.com"
  },
  "homepage": "https://logcut.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logcut/logcut.git"
  },
  "bugs": {
    "url": "https://github.com/logcut/logcut/issues"
  },
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "pnpm --filter logcut dev",
    "build": "pnpm --filter logcut build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:core": "node scripts/check-core-boundary.mjs",
    "verify": "pnpm check:core && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron-winstaller"
    ]
  }
}
