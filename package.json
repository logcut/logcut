{
  "name": "logcut-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "pnpm --filter logcut dev",
    "build": "pnpm --filter logcut build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:core": "node scripts/check-core-boundary.mjs",
    "verify": "pnpm check:core && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron-winstaller"
    ]
  }
}
